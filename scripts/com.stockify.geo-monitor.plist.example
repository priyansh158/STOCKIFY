<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install:
    cp scripts/com.stockify.geo-monitor.plist.example ~/Library/LaunchAgents/com.stockify.geo-monitor.plist
    chmod +x "/Users/mac/Developer/STOCKIFY/scripts/run_geo_monitor.sh"
    launchctl unload ~/Library/LaunchAgents/com.stockify.geo-monitor.plist 2>/dev/null
    launchctl load ~/Library/LaunchAgents/com.stockify.geo-monitor.plist

  Uses run_geo_monitor.sh so PYTHONPATH/cwd are correct under launchd.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stockify.geo-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mac/Developer/STOCKIFY/scripts/run_geo_monitor.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/stockify-geo-monitor.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/stockify-geo-monitor.err.log</string>
</dict>
</plist>
